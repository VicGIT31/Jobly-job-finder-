generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum ContractType {
  CDI
  CDD
  STAGE
  ALTERNANCE
  VIE
  // Types employeur génériques utilisés par les sources internationales
  // (spec europe_asia_ai_job_platform_mvp_prompt.md §7). Le périmètre
  // stage/alternance strict (`ACCEPTED_CONTRACTS` dans normalize.ts) reste
  // inchangé pour les sources françaises existantes — ces valeurs ne sont
  // acceptées que pour les connecteurs qui le demandent explicitement.
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum RemotePolicy {
  ONSITE
  HYBRID
  FULL
}

enum EducationLevel {
  BAC
  BAC_2
  BAC_3
  BAC_5
  DOCTORAT
  INDIFFERENT
}

enum OfferStatus {
  ACTIVE
  EXPIRED
}

/**
 * Spécialité tech d'une offre, déduite du titre et de la description
 * (`server/ingest/classify.ts`). Le secteur remonté par les sources vaut
 * toujours « Tech / Informatique » : c'est cette classification qui permet de
 * filtrer par métier. `AUTRE` = aucun signal suffisant, pas de devinette.
 */
enum TechSpecialty {
  IA
  CYBERSECURITE
  WEB
  DEVOPS
  SOFTWARE
  RESEAUX
  AUTRE
}

enum AlertFrequency {
  DAILY
  WEEKLY
  NEVER
}

enum IngestResult {
  CREATED
  UPDATED
  DUPLICATE
  REJECTED
}

/**
 * État d'une candidature dans le suivi personnel (`/mon-espace/candidatures`).
 * SAVED = offre mise de côté sans candidature envoyée (créé aussi par
 * `SavedOffer`, mais ici c'est une entrée explicite du suivi). REJECTED et
 * WITHDRAWN restent visibles mais hors du tableau actif.
 */
enum ApplicationStatus {
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

// ---------- Auth (Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  // Identifiant de connexion alternatif à l'email (comptes internes). Optionnel
  // et unique : la plupart des comptes candidats n'en ont pas.
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  // Compte suspendu par un administrateur : la connexion est refusée tant que
  // la date est renseignée (le compte et ses données sont conservés).
  suspendedAt   DateTime?

  // Profil candidat
  school          String?
  graduationYear  Int?
  headline        String?
  city            String?
  // Préférences utilisées par le score de correspondance transparent
  // (`src/server/match/score.ts`) : `null` = non renseigné, jamais deviné.
  educationLevel  EducationLevel?
  targetSpecialty TechSpecialty?
  cvKey           String? // clé S3 du CV
  cvFilename      String?
  cvUploadedAt    DateTime?
  // Texte brut extrait du PDF à l'upload (src/server/cv/extract-text.ts),
  // pour la comparaison de mots-clés avec une offre (src/server/cv/analyze.ts).
  // Jamais analysé par IA — voir CONTEXTE_AI_WORK.md.
  cvText          String?

  accounts      Account[]
  sessions      Session[]
  savedOffers   SavedOffer[]
  hiddenOffers  HiddenOffer[]
  savedSearches SavedSearch[]
  applyClicks   ApplyClick[]
  applications  Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Métier ----------

model Company {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logoUrl     String?
  description String
  sector      String
  size        String // ex. "1-10", "11-50", "51-200", "201-1000", "1000+"
  website     String?
  featured    Boolean @default(false)

  offers JobOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model JobOffer {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String // markdown/HTML riche
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractType   ContractType
  city           String
  // ISO 3166-1 alpha-2. Toutes les offres existantes (sources françaises)
  // valent "FR" par défaut — ajouté pour l'extension Europe/Asie sans
  // migration de données ni changement de comportement pour l'existant.
  countryCode    String         @default("FR")
  latitude       Float?
  longitude      Float?
  remotePolicy   RemotePolicy   @default(ONSITE)
  salaryMin      Int?
  salaryMax      Int?
  educationLevel EducationLevel @default(INDIFFERENT)
  sector         String
  specialty      TechSpecialty  @default(AUTRE)

  // Provenance scraping
  sourceUrl  String
  sourceSite String
  scrapedAt  DateTime
  lastSeenAt DateTime
  dedupHash  String      @unique
  status     OfferStatus @default(ACTIVE)
  // Offre bloquée par un modérateur. Sans ce drapeau, l'ingestion suivante la
  // retrouverait sur la source et la repasserait en ACTIVE : la modération
  // serait annulée toute seule au bout de 30 minutes.
  blockedAt  DateTime?

  publishedAt DateTime @default(now())
  validThrough DateTime?

  savedBy      SavedOffer[]
  hiddenBy     HiddenOffer[]
  applyClicks  ApplyClick[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([status, validThrough])
  @@index([companyId, status])
  @@index([lastSeenAt])
  @@index([blockedAt])
  @@index([specialty, status])
  @@index([countryCode, status])
  @@index([sourceUrl])
  @@map("job_offers")
}

model SavedOffer {
  id        String   @id @default(cuid())
  userId    String
  offerId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, offerId])
  @@map("saved_offers")
}

/**
 * Offre masquée par un candidat (§8/§9 : « previously dismissed jobs »).
 * Exclue des résultats de recherche pour cet utilisateur — voir
 * `src/server/offers/hidden-filter.ts`.
 */
model HiddenOffer {
  id        String   @id @default(cuid())
  userId    String
  offerId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer     JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, offerId])
  @@map("hidden_offers")
}

model SavedSearch {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Query params sérialisés de la recherche (q, ville, contrat, remote, etc.)
  params     Json
  frequency  AlertFrequency @default(DAILY)
  lastSentAt DateTime?
  createdAt  DateTime       @default(now())

  @@map("saved_searches")
}

model ApplyClick {
  id        String   @id @default(cuid())
  offerId   String
  offer     JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clickedAt DateTime @default(now())
  referer   String?

  @@index([offerId, clickedAt])
  @@index([userId])
  @@map("apply_clicks")
}

/**
 * Suivi de candidature personnel (tableau Kanban `/mon-espace/candidatures`).
 * `offerId` est optionnel : une candidature peut être liée à une offre scrapée
 * (créée automatiquement au clic « Postuler ») ou ajoutée manuellement (offre
 * externe hors périmètre Jobly). Les champs `companyName`/`jobTitle` sont
 * dupliqués depuis l'offre au moment de la création : la candidature doit
 * rester lisible même si l'offre expire ou est supprimée.
 */
model Application {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId String?
  offer   JobOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  companyName    String
  jobTitle       String
  companyLogoUrl String?
  sourceUrl      String?

  status    ApplicationStatus @default(SAVED)
  notes     String?
  appliedAt DateTime?

  history ApplicationStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une seule entrée de suivi par offre et par utilisateur (les entrées
  // manuelles, offerId = null, ne sont pas concernées par cette contrainte).
  @@unique([userId, offerId])
  @@index([userId, status])
  @@map("applications")
}

/**
 * Historique des changements de statut d'une candidature (jamais écrasé).
 */
model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  changedAt     DateTime          @default(now())

  @@index([applicationId, changedAt])
  @@map("application_status_history")
}

/**
 * Réglages du site pilotés depuis le panneau d'administration (SEO, contenu de
 * la page d'accueil, paramètres d'ingestion). Un enregistrement par clé, valeur
 * JSON libre : ajouter un réglage ne demande pas de migration.
 */
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

/**
 * Journal d'audit : trace toute action d'administration (qui, quoi, quand).
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/**
 * Bilan d'un passage de connecteur (une ligne par source et par cycle).
 * `IngestLog` trace l'offre, `IngestRun` trace la santé de la source :
 * volume, durée, erreur — c'est ce que le panneau admin surveille.
 */
model IngestRun {
  id         String   @id @default(cuid())
  sourceSite String
  label      String
  ok         Boolean
  fetched    Int      @default(0)
  created    Int      @default(0)
  updated    Int      @default(0)
  duplicates Int      @default(0)
  rejected   Int      @default(0)
  durationMs Int      @default(0)
  error      String?
  coverageJson Json?
  startedAt  DateTime @default(now())

  @@index([startedAt])
  @@index([sourceSite, startedAt])
  @@map("ingest_runs")
}

model IngestLog {
  id         String       @id @default(cuid())
  sourceSite String
  result     IngestResult
  offerId    String?
  dedupHash  String?
  rawTitle   String?
  message    String?
  createdAt  DateTime     @default(now())

  @@index([sourceSite, createdAt])
  @@index([result, createdAt])
  @@map("ingest_logs")
}
