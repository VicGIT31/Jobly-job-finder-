{
  "name": "jobly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-all.mjs --dev",
    "dev:web": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-all.mjs",
    "start:web": "next start",
    "start:all": "node scripts/start-all.mjs",
    "worker": "tsx src/workers/index.ts",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:ensure": "tsx scripts/create-admin.ts --if-configured",
    "ingest:now": "tsx scripts/ingest-now.ts",
    "ingest:file": "tsx scripts/import-offers.ts",
    "collect:offers": "tsx scripts/collect-offers.ts",
    "sources:list": "tsx scripts/sources-check.ts --list",
    "sources:check": "tsx scripts/sources-check.ts",
    "sources:discover": "tsx scripts/discover-sources.ts",
    "sources:expand": "tsx scripts/expand-france-sources.ts",
    "alerts:import": "tsx scripts/import-job-alerts.ts",
    "offers:audit": "tsx scripts/audit-offer-scope.ts",
    "search:sync": "tsx scripts/search-sync.ts",
    "geo:backfill": "tsx scripts/geocode-backfill.ts",
    "specialty:backfill": "tsx scripts/specialty-backfill.ts",
    "contract:backfill": "tsx scripts/contract-backfill.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.5",
    "cheerio": "1.0.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.31.0",
    "mailparser": "3.9.36",
    "meilisearch": "^0.59.0",
    "motion": "^12.43.0",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "nuqs": "^2.9.0",
    "pdf-parse": "^1.1.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.17.2",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.29",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.20",
    "deepmerge-ts": "^8.0.2"
  }
}
