{
  "name": "jobly",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-all.mjs --dev",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "node scripts/start-all.mjs",
    "start:web": "next start --hostname 127.0.0.1",
    "start:all": "node scripts/start-all.mjs",
    "worker": "tsx src/workers/index.ts",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx prisma/seed.ts",
    "ingest:now": "tsx scripts/ingest-now.ts",
    "ingest:file": "tsx scripts/import-offers.ts",
    "collect:offers": "tsx scripts/collect-offers.ts",
    "sources:list": "tsx scripts/sources-check.ts --list",
    "sources:check": "tsx scripts/sources-check.ts",
    "discovery:configure": "node scripts/configure-discovery.mjs",
    "sources:discover": "tsx scripts/discover-sources.ts",
    "sources:expand": "tsx scripts/expand-france-sources.ts",
    "alerts:import": "tsx scripts/import-job-alerts.ts",
    "offers:audit": "tsx scripts/audit-offer-scope.ts",
    "offers:refresh": "tsx scripts/refresh-offers.ts",
    "search:sync": "tsx scripts/search-sync.ts",
    "geo:backfill": "tsx scripts/geocode-backfill.ts",
    "specialty:backfill": "tsx scripts/specialty-backfill.ts",
    "contract:backfill": "tsx scripts/contract-backfill.ts",
    "postinstall": "prisma generate",
    "desktop:prepare": "npm run desktop:guides && npm run build && node scripts/desktop-build.mjs",
    "desktop:run": "electron build/desktop-app",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder --config electron-builder.cjs",
    "desktop:delivery": "npm run desktop:guides && node scripts/desktop-delivery.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:export-web": "tsx scripts/desktop-export-web.ts",
    "desktop:install-test": "node scripts/desktop-install.mjs",
    "desktop:command-test": "node scripts/desktop-command-test.mjs",
    "desktop:guides": "node scripts/desktop-guides.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.2",
    "bullmq": "^5.80.5",
    "cheerio": "1.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.31.0",
    "mailparser": "3.14.1",
    "meilisearch": "^0.59.0",
    "motion": "^12.43.0",
    "next": "^15.5.24",
    "nuqs": "^2.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "8.16.3",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.17.2",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "8.15.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.10",
    "archiver": "7.0.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.24",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.20",
    "deepmerge-ts": "^8.0.2"
  }
}
