# Développement web LOCAL uniquement. Aucun .env n’est embarqué dans l’application.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://nextstep:nextstep@localhost:5432/nextstep?schema=public
REDIS_URL=redis://localhost:6379
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=change-me-local-search-key
# API d’ingestion développeur, facultative ; ne jamais exposer le service personnel.
INGEST_API_KEY=change-me-local-ingest-key
OFFER_FRESHNESS_DAYS=7
OFFER_MAX_AGE_DAYS=60
INGESTION_INTERVAL_MINUTES=120
INGEST_SOURCE_TIMEOUT_SECONDS=180
# Les collecteurs personnels de config/personal-sources.json sont actifs par défaut.
# Exemples : anicura-asv,ft-commerce-toulouse,ft-marketing-toulouse,metro-commerce
INGEST_SOURCES=
INGEST_CACHE_DIR=.cache/jobly
# Ancien catalogue tech, sélection explicite uniquement.
JOB_SOURCES_FILE=
JOB_ALERTS_DIR=data/job-alerts
# Stockage web local, uniquement pour le développement ; bureau = fichiers privés locaux.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nextstep
S3_SECRET_KEY=change-me-local-storage-key
S3_BUCKET_CV=nextstep-cv
EMAIL_PROVIDER=console
# Fournisseurs optionnels de développement backend ; jamais inclus dans le bureau.
RESEND_API_KEY=
EMAIL_FROM=Jobly <no-reply@jobly.example>
ANTHROPIC_API_KEY=
# Aucun compte d’application, OAuth ou mot de passe administrateur.
