# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://nextstep:nextstep@localhost:5432/nextstep?schema=public

# --- Redis (cache + rate limiting + BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=nextstep_meili_master_key

# --- Ingestion interne ---
INGEST_API_KEY=change-me-ingest-key
# Offres non revues depuis X jours => expirées
OFFER_FRESHNESS_DAYS=7
# Offres publiées il y a plus de X jours => supprimées définitivement (2 mois)
OFFER_MAX_AGE_DAYS=60
# Fréquence de scraping des offres réelles (minutes)
INGESTION_INTERVAL_MINUTES=120
# Budget maximal par source ; conserve les résultats déjà collectés (30..3600 s).
INGEST_SOURCE_TIMEOUT_SECONDS=900

# --- Sources d'offres réelles ---
# Collecte directe gratuite, sans compte développeur ni abonnement.
# Catalogue d'entreprises modifiable : config/job-sources.json
# Chemin optionnel d'un catalogue local qui remplace celui du dépôt.
JOB_SOURCES_FILE=
# Sélection optionnelle : IDs du catalogue ou domaines des connecteurs historiques.
# Exemple : airbus,thales,decathlon,capgemini,hellowork.com,free-work.com
INGEST_SOURCES=
# Réponses publiques en cache (détails 4h, sitemaps 1h).
INGEST_CACHE_DIR=.cache/jobly
# Dossier d'alertes email .eml locales (facultatif, aucune API de messagerie).
JOB_ALERTS_DIR=data/job-alerts

# --- Auth ---
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Stockage S3 (MinIO en dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=nextstep
S3_SECRET_KEY=nextstep-secret
S3_BUCKET_CV=nextstep-cv

# --- Emails ---
# console = gratuit et local. Resend reste une option distincte de la collecte.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Jobly <no-reply@jobly.example>

# --- IA (brouillon de réponse de candidature) ---
# Clé API Anthropic : https://console.anthropic.com. Sans cette clé, un
# gabarit déterministe (sans IA) est utilisé à la place — voir
# src/server/ai/mock-provider.ts. Jamais présenté comme « généré par IA ».
ANTHROPIC_API_KEY=

# --- Compte administrateur ---
# Le panneau /admin n'est accessible qu'aux comptes de rôle ADMIN. Aucun compte
# admin n'est créé par le seed : renseignez ces variables dans votre `.env`
# (non versionné) puis lancez `npm run admin:create`.
# ADMIN_EMAIL est optionnel : par défaut `<ADMIN_USERNAME>@jobly.local`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
